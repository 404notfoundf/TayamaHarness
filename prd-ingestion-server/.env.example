# PRD 前置转换系统 - 环境变量配置

# MySQL 配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_USER=prd_user
MYSQL_PASSWORD=prd_user_2024
MYSQL_PORT=3306

# 应用配置
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# 数据库连接（应用）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prd_ingestion
DB_USERNAME=root
DB_PASSWORD=root123456
DB_POOL_SIZE=10

# MinIO 对象存储配置
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_UPLOADS=prd-uploads
MINIO_BUCKET_MERGED=prd-merged

# AI/LLM 解析（对应 application.yml 的 ai.*）
# false 时仅用模板 + 关键词匹配；true 时走 LLM
AI_ENABLED=false
# 开发调试不真正调 API；生产环境设为 false 并填写 AI_API_KEY
AI_MOCK=false
# OpenAI 兼容 chat/completions 端点
AI_API_URL=https://token.sensenova.cn/v1/chat/completions
# 生产务必用真实密钥，不要提交到仓库
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT=60
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.0
# 仅排查问题时临时设 true（日志会打印完整 API Key）
AI_LOG_FULL_API_KEY=false
# none 关闭思考型模型深度思考（sensenova/glm 推荐）；留空则不传该参数（兼容 OpenAI）
AI_REASONING_EFFORT=none
# 短内容判定阈值（字符数），低于此值的 PRD 走增强解析
AI_SHORT_CONTENT_THRESHOLD=200


