# =============================================================================
# 前端环境变量示例（复制为 .env 后按需修改）
# =============================================================================

# API 请求全局超时（毫秒）。默认 180000（180 秒）。
# 注意：PRD 导入是「同步等待解析全流程（模板→LLM→写库）完成」才返回，
# LLM 调用最长可达后端的 ai.timeout（默认 60 秒），加上解析/写库耗时，
# 请保证该值 > 后端 ai.timeout + 15 秒余量。若调大了后端 AI_TIMEOUT，这里也要相应调大。
VITE_API_TIMEOUT=180000